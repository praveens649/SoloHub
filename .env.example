# Solohub Chrome Extension - Environment Variables
# Copy this file to .env.local for local development.

# GitHub OAuth App Client ID (Public Identifier)
# Required for OAuth authorization. Obtain from:
# GitHub -> Settings -> Developer Settings -> OAuth Apps -> [Your App]
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id_here

# Backend OAuth Token Exchange Server URL
# In development: defaults to http://localhost:3001 if left empty.
# In production: MUST be an HTTPS URL pointing to your deployed backend (e.g., https://auth.yourdomain.com).
VITE_BACKEND_URL=http://localhost:3001

# CRITICAL SECURITY WARNING:
# NEVER put GITHUB_CLIENT_SECRET in this file or any file in the frontend project!
# Client secrets are kept exclusively on the backend server.
