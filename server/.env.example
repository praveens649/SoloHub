# GitHub OAuth Application Credentials
# Obtain these from: GitHub -> Settings -> Developer Settings -> OAuth Apps
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here

# Server Configuration
PORT=3001
NODE_ENV=development

# Optional Security Controls
# Comma-separated list of allowed Origins for CORS (e.g., chrome-extension://<id>,http://localhost:5173)
# Leave empty in development to allow local frontend and chromium extensions
ALLOWED_ORIGINS=

# Comma-separated list of allowed redirect URIs (e.g., https://<id>.chromiumapp.org/)
# Leave empty to use the default validator matching standard https://*.chromiumapp.org/ URLs
ALLOWED_REDIRECT_URIS=

# Enforce OAuth state verification on /auth/github/exchange (true/false)
# Set to false during development or before frontend coordinates state; set to true in production
REQUIRE_OAUTH_STATE=false
